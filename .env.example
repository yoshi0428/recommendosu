OSU_CLIENT_ID=YOUR_CLIENT_ID
OSU_CLIENT_SECRET=YOUR_CLIENT_SECRET

# Discord bot (bot/). BOT_API_KEY is shared by the bot and the backend;
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
BOT_API_KEY=YOUR_BOT_API_KEY

# The dev Discord bot, run by the local stack (compose.local.yml): the token of
# a second Discord application, and the ID of the test server its commands
# appear in (they update there instantly).
DEV_DISCORD_TOKEN=YOUR_DEV_DISCORD_BOT_TOKEN
DEV_BOT_GUILD_ID=YOUR_TEST_SERVER_ID