{
  // Run with Terminal > Run Task..., or Ctrl+Shift+P > "Tasks: Run Test Task".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend tests",
      "type": "shell",
      "command": "python -m pytest",
      "group": "test",
      "problemMatcher": []
    },
    {
      // Only the tests marked slow (they're skipped by default in pytest.ini).
      "label": "Backend slow tests",
      "type": "shell",
      "command": "python -m pytest -m slow",
      "group": "test",
      "problemMatcher": []
    },
    {
      // Fast + slow. The later -m overrides the "not slow" from addopts.
      "label": "Backend tests (incl. slow)",
      "type": "shell",
      "command": "python -m pytest -m \"slow or not slow\"",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend tests",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "All tests",
      "dependsOn": ["Backend tests", "Frontend tests"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "All tests (incl. slow)",
      "dependsOn": ["Backend tests (incl. slow)", "Frontend tests"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
