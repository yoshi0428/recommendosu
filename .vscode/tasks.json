{
  // Run with Terminal > Run Task..., or Ctrl+Shift+P > "Tasks: Run Test Task".
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend tests",
      "type": "shell",
      "command": "python -m pytest",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend tests",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "All tests",
      "dependsOn": ["Backend tests", "Frontend tests"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
